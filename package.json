{
  "name": "student-course-project-collaboration-and-progress-management-system",
  "version": "0.1.0",
  "private": true,
  "description": "学生课程项目协作与进度管理系统（Electron + React / NestJS / Prisma / SQLite）",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "dev": "concurrently -n api,desktop -c blue,green \"pnpm dev:api\" \"pnpm dev:desktop\"",
    "dev:api": "pnpm --filter @scpc/api dev",
    "dev:desktop": "pnpm --filter @scpc/desktop dev",
    "build": "pnpm -r --if-present build",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "node scripts/ensure-database-file.mjs && prisma migrate dev --schema prisma/schema.prisma",
    "db:seed": "node scripts/ensure-database-file.mjs && prisma db seed --schema prisma/schema.prisma",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@prisma/client": "6.19.3",
    "@types/node": "^24.13.6",
    "concurrently": "^9.2.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.0.0",
    "prettier": "^3.9.8",
    "prisma": "6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
